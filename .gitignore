# Large, broker-specific research inputs stay local.
/raw_data/

# Large, immutable local exploration packages across all families/versions.
# The invalidated V1 ledgers are kept on disk but excluded from publishable Git history.
/Research Candidate/*/*/run_*/

# Local symbol wish list; the tracked 28-pair whitelist is in README.MD.
/Docs/SYMBOL_PLACEHOLDER_FOLDER/

# Python runtime and local environments.
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# Local MetaEditor build outputs; source code remains tracked.
/Docs/MT5_EXPORTER_SCRIPT/new/*.ex5
/Docs/MT5_EXPORTER_SCRIPT/new/*.log
